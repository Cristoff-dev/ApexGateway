{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "redis": "localhost:6379"
  },
  "ReverseProxy": {
    "Routes": {
      "ai-route": {
        "ClusterId": "openai-cluster",
        "RateLimitingPolicy": "FixedWindowPolicy",
        "Match": {
          "Path": "/api/v1/ai/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/ai" }
        ]
      }
    },
    "Clusters": {
      "openai-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://api.openai.com/v1/"
          }
        }
      }
    }
  }
}
